        <messages/>
        <name>Hide the time</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var expenseDate = g_form.getValue('expense_date'); 
    if (expenseDate) {
        
        var dateParts = expenseDate.split(' ');
        var dateOnly = dateParts[0]; 
        
        var formattedDate = dateOnly.split('-').reverse().join('/'); 
        
        g_form.setValue('expense_date', formattedDate);
    }
}]]></script>
